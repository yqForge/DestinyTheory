# 复制到 .env.local，参考 docs/LOCAL-AI.md。不要提交实际密钥。
# 普通排盘无需 AI 配置；网页内也可直接登录服务商或保存 API Key（见 docs/AI-PROVIDERS.md）。
# /api/heming 合盘 AI 尚未实现。

# github-copilot / deepseek / mimo / openai / ollama / custom
# 复用本机 Pi 的 Copilot 登录，不复制 OAuth 令牌，也无需另填 Key。
AI_PROVIDER=github-copilot
AI_MODEL=gpt-6.1-sol
AI_REASONING=medium
# 若没有登录，请先在 Pi 中执行 /login github-copilot。
# AI_MODEL 是网页初始默认值，须为你有权访问的 Copilot 模型 ID。
# 网页也可从账号实时目录选择其他兼容模型，无需改此文件；见 docs/MODEL-SELECTION.md。

# 若改用 DeepSeek，请同时清除上面的 AI_MODEL 或改为 deepseek-chat：
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# 通用配置优先于服务商专用配置；地址为 API 基址，不含 /chat/completions
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=model-name
# AI_API_KEY=
AI_MAX_TOKENS=8192
AI_TIMEOUT_MS=180000

# MiMo：按服务商文档填写，不猜测其可用模型与地址
# AI_PROVIDER=mimo
# MIMO_API_KEY=
# MIMO_BASE_URL=https://your-provider.example/v1
# MIMO_MODEL=model-name

# 本机 Ollama（需自行启动模型，模型名与 ollama list 一致）
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=your-installed-model
# 本机无鉴权服务可不填 API Key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
