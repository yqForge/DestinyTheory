import assert from 'node:assert/strict';
import { existsSync } from 'node:fs';
import { mkdir } from 'node:fs/promises';
import { resolve } from 'node:path';
import { chromium } from 'playwright-core';
import { createAIMockState, handleAIMock } from './ai-mocks.mjs';

const base = process.env.UI_BASE_URL || 'http://127.0.0.1:3000';
assert.ok(['localhost', '127.0.0.1', '[::1]'].includes(new URL(base).hostname));
const executable = process.env.CHROME_PATH || ['/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/usr/bin/google-chrome', '/usr/bin/chromium'].find(existsSync);
if (!executable) throw new Error('请设置 CHROME_PATH');
const browser = await chromium.launch({ executablePath: executable, headless: process.env.UI_HEADED !== '1' });
const artifacts = resolve(process.env.UI_ARTIFACT_DIR || '.artifacts/ui');
await mkdir(artifacts, { recursive: true });
const errors: string[] = [];
try {
  for (const width of [1440, 390, 320]) {
    const page = await browser.newPage({ viewport: { width, height: width === 320 ? 568 : 900 } });
    page.on('pageerror', error => errors.push(error.message));
    const requests: { provider: string; model: string; messages: { role: string; content: string }[] }[] = [];
    let mode: 'ok' | 'hold' = 'ok';
    const ai = createAIMockState();
    ai.models['github-copilot'] = [{ id: 'gpt-6.1-sol', name: 'GPT-6.1 Sol' }, { id: 'gemini-3.8-flash', name: 'Gemini 3.8 Flash' }];
    await page.route('**/*', async route => {
      const request = route.request();
      if (!request.url().startsWith(base + '/')) { await route.abort(); return; }
      if (await handleAIMock(route, ai)) return;
      if (new URL(request.url()).pathname !== '/api/interpret') { await route.continue(); return; }
      const payload = request.postDataJSON();
      requests.push(payload);
      assert.equal(payload.consent, true);
      const body = `data: ${JSON.stringify({ delta: { text: `浏览器模型测试：${payload.provider}/${payload.model}（第${requests.length}轮）` } })}\n\ndata: [DONE]\n\n`;
      if (mode === 'hold') await new Promise(resolve => setTimeout(resolve, 1200));
      await route.fulfill({ contentType: 'text/event-stream', headers: { 'X-AI-Provider': payload.provider, 'X-AI-Model': encodeURIComponent(payload.model) }, body }).catch(() => {});
    });
    await page.goto(base + '/chart');
    await page.getByRole('combobox', { name: '出生年份', exact: true }).selectOption('2000');
    await page.getByRole('combobox', { name: '出生月份', exact: true }).selectOption('2');
    await page.getByRole('combobox', { name: '出生日期', exact: true }).selectOption('5');
    await page.getByRole('button', { name: /立即起盘/ }).click();
    await page.waitForFunction(() => Array.from(document.querySelectorAll('button')).some(button => button.textContent?.includes('同意发送') && !button.disabled));
    const picker = () => page.locator('#ai-pane details[aria-label="解读模型选择"]');
    const open = async () => { if (!await picker().evaluate(element => (element as HTMLDetailsElement).open)) await picker().locator('summary').click(); };
    const provider = () => picker().getByRole('combobox', { name: '模型服务' });
    const model = () => picker().getByRole('combobox', { name: '选择解读模型' });
    await open();
    assert.equal(await provider().locator('option[value="kiro"]').isDisabled(), true, 'Kiro must be visibly unsupported');
    await model().selectOption('gemini-3.8-flash');
    assert.equal(requests.length, 0, 'selection before consent must not infer');
    await open();
    await provider().selectOption('deepseek');
    await picker().getByRole('button', { name: '配置 API Key' }).click();
    await picker().getByLabel('Enter DeepSeek API key').fill('sk-browser-test-only');
    await picker().getByRole('button', { name: '保存并连接' }).click();
    await picker().getByText('已连接，正在刷新可用模型。').waitFor();
    await page.waitForFunction(() => Array.from(document.querySelectorAll('#ai-pane option')).some(option => option.textContent?.includes('DeepSeek Chat')));
    assert.equal(ai.logins.at(-1)?.value, 'sk-browser-test-only');
    assert.ok(!(await page.content()).includes('sk-browser-test-only'), 'secret is not rendered back into the page');
    assert.equal(requests.length, 0, 'connecting a provider does not send a chart');
    await model().selectOption('deepseek-chat');
    const confirm = page.getByRole('button', { name: '同意发送，开始 AI 解读' });
    await open();
    await picker().locator('summary').click();
    const rect = await confirm.boundingBox();
    assert.ok(rect && rect.y >= 0 && rect.y + rect.height <= page.viewportSize()!.height);
    await confirm.click();
    await page.getByText('浏览器模型测试：deepseek/deepseek-chat（第1轮）', { exact: true }).waitFor();
    assert.deepEqual([requests[0].provider, requests[0].model], ['deepseek', 'deepseek-chat']);
    await page.getByText('✦ 命理解读 · deepseek / deepseek-chat', { exact: true }).waitFor();
    await open();
    await provider().selectOption('github-copilot');
    await page.waitForFunction(() => Array.from(document.querySelectorAll('#ai-pane option')).some(option => option.textContent?.includes('Gemini 3.8 Flash')));
    await model().selectOption('gemini-3.8-flash');
    assert.equal(requests.length, 1, 'switching provider/model must not auto-send');
    const question = page.getByRole('textbox', { name: '向 AI 提问' });
    await question.fill('换服务商和模型继续分析');
    await question.press('Enter');
    await page.getByText('浏览器模型测试：github-copilot/gemini-3.8-flash（第2轮）', { exact: true }).waitFor();
    assert.ok(requests[1].messages.some(message => message.role === 'assistant' && message.content.includes('deepseek-chat')));
    assert.equal(await page.getByText('✦ 命理解读 · deepseek / deepseek-chat', { exact: true }).count(), 1);
    mode = 'hold';
    await question.fill('生成过程中禁止切换');
    await question.press('Enter');
    await page.getByRole('button', { name: '停止生成', exact: true }).waitFor();
    await open();
    assert.equal(await provider().isDisabled(), true);
    assert.equal(await model().isDisabled(), true);
    await page.getByRole('button', { name: '停止生成', exact: true }).click();
    await page.locator('#ai-pane [role="alert"]').filter({ hasText: '已停止生成' }).waitFor();
    await model().selectOption('gpt-6.1-sol');
    mode = 'ok';
    const beforeRetry = requests.length;
    await page.getByRole('button', { name: '重新尝试', exact: true }).click();
    await page.waitForFunction(() => !document.querySelector('[aria-busy="true"]'));
    assert.equal(requests.length, beforeRetry + 1);
    assert.deepEqual([requests.at(-1)?.provider, requests.at(-1)?.model], ['github-copilot', 'gpt-6.1-sol']);
    ai.models['github-copilot'] = [{ id: 'gemini-3.8-flash', name: 'Gemini 3.8 Flash' }];
    await open();
    await picker().getByRole('button', { name: '刷新模型列表' }).click();
    await picker().getByText(/先前选择的模型已不在目录/).waitFor();
    assert.equal(await model().inputValue(), '');
    assert.equal(await page.getByRole('button', { name: '发送', exact: true }).isDisabled(), true);
    assert.ok(ai.modelGets.some(url => new URL(url).searchParams.get('refresh') === '1'));
    await model().selectOption('gemini-3.8-flash');
    ai.modelFailure = true;
    await open();
    await picker().getByRole('button', { name: '刷新模型列表' }).click();
    await picker().getByRole('alert').filter({ hasText: '无法读取 AI 模型列表' }).waitFor();
    await question.fill('列表失败不能偷偷发送');
    assert.equal(await page.getByRole('button', { name: '发送', exact: true }).isDisabled(), true);
    ai.modelFailure = false;
    await page.getByRole('button', { name: '刷新模型列表' }).click();
    await page.waitForFunction(() => !(document.querySelector('#ai-pane select[id$="-r1"]') as HTMLSelectElement | null)?.disabled);
    await picker().locator('summary').click();
    const box = await question.boundingBox();
    assert.ok(box && box.y + box.height <= page.viewportSize()!.height, 'provider/model selector must not push the composer outside the viewport');
    await page.screenshot({ path: `${artifacts}/provider-model-${width}.png` });
    await page.close();
    console.log(`✓ ${width}px：Kiro 禁用、API Key 连接不回显、服务商/模型切换不自动调用、跨服务追问与标记、生成锁定、重试、刷新与失败恢复`);
  }
  assert.deepEqual(errors, []);
  console.log('多服务商模型选择浏览器回归通过（独立虚构资料，登录、目录与解读均模拟，无真实账号/模型调用）');
} finally { await browser.close(); }
